@echo off
setlocal DisableDelayedExpansion
title Antigravity Proxy Helper
set "AGY_SINGLE_FILE=%~f0"
"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop';$result=1;$base=[IO.Path]::GetFullPath([IO.Path]::GetTempPath()).TrimEnd('\')+'\';$tmp=Join-Path $base ('AntigravityProxy-'+[guid]::NewGuid().ToString('N'));try{$data=[IO.File]::ReadAllText($env:AGY_SINGLE_FILE);$marker=':AGY_EMBEDDED_ZIP:';$index=$data.LastIndexOf($marker,[StringComparison]::Ordinal);if($index -lt 0){throw 'Package data is missing.'};[IO.Directory]::CreateDirectory($tmp)|Out-Null;$zip=Join-Path $tmp 'payload.zip';[IO.File]::WriteAllBytes($zip,[Convert]::FromBase64String($data.Substring($index+$marker.Length)));Add-Type -AssemblyName System.IO.Compression.FileSystem;[IO.Compression.ZipFile]::ExtractToDirectory($zip,(Join-Path $tmp 'payload'));& (Join-Path $tmp 'payload\launcher.ps1') -LegacyRoot ([IO.Path]::GetDirectoryName($env:AGY_SINGLE_FILE));$result=$LASTEXITCODE}catch{Write-Host ('Startup failed: '+$_.Exception.Message) -ForegroundColor Red}finally{if(([IO.Path]::GetFullPath($tmp)).StartsWith($base,[StringComparison]::OrdinalIgnoreCase) -and (Test-Path -LiteralPath $tmp)){Remove-Item -LiteralPath $tmp -Recurse -Force -ErrorAction SilentlyContinue}};exit $result"
set "AGY_EXIT_CODE=%errorlevel%"
if not "%AGY_EXIT_CODE%"=="0" (
  echo.
  echo Setup did not complete. See the message above.
  pause
)
exit /b %AGY_EXIT_CODE%
